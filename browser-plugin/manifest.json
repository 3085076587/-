{
  "manifest_version": 3,
  "name": "千川方舟",
  "version": "1.7.37",
  "description": "进入千川全域投放商品计划页后填写实际退款率和佣金，预估利润直接显示在原站表格上。",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://qianchuan.jinritemai.com/*",
    "http://120.76.58.132:8081/*"
  ],
  "action": {
    "default_title": "千川方舟"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://qianchuan.jinritemai.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
