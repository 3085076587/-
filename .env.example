APP_NAME=Ad Helper Qianchuan ERP
DEBUG=true

# 巨量开放平台应用凭证（应用管理里查看，不要提交真实值）
OCEANENGINE_APP_ID=
OCEANENGINE_SECRET=
OCEANENGINE_API_BASE=https://api.oceanengine.com/open_api

# MySQL
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/ad_helper?charset=utf8mb4
AUTO_CREATE_TABLES=true

# 必须与巨量后台回调地址完全一致
OAUTH_CALLBACK_URL=https://chuanqian-test.free.idcfengye.com/api/oauth/callback

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
DASHBOARD_CONCURRENCY=8
DASHBOARD_CACHE_INTERVAL_SECONDS=1800

# 登录账号在数据库 sys_user，密码是哈希。这里只保留会话签名密钥。
SESSION_SECRET=change-me-ad-helper-session-secret
SESSION_MAX_AGE_SECONDS=604800
